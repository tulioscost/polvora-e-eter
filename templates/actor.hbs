<div class="pe-root">
 <header class="pe-header">
  <img class="pe-portrait" src="{{actor.img}}" alt="Retrato" data-action="editImage" data-edit="img" title="Alterar retrato" />
  <div class="pe-heading">
   <div class="pe-eyebrow">PÓLVORA &amp; ÉTER · ARQUIVO DE CAMPO</div>
   <input class="pe-name" name="name" value="{{actor.name}}" aria-label="Nome" />
   <div class="pe-tagline">{{#if isSquad}}Ficha de unidade persistente{{else if isThreat}}Registro de ameaça{{else}}Soldado / agente • Guerra das Cinzas{{/if}}</div>
  </div>
  {{#unless isSquad}}
   <div class="pe-vitals">
    <div><label>PV</label><strong>{{system.pv.value}} / {{system.pv.max}}</strong><span><button type="button" data-action="modify" data-field="system.pv.value" data-delta="-1">−</button><button type="button" data-action="modify" data-field="system.pv.value" data-delta="1">+</button></span></div>
    <div><label>BPM</label><strong>{{system.bpm.value}}</strong><small>{{bpmState}}</small><span><button type="button" data-action="modify" data-field="system.bpm.value" data-delta="-10">−10</button><button type="button" data-action="modify" data-field="system.bpm.value" data-delta="10">+10</button></span></div>
    <div><label>RD</label><strong>{{rd}}</strong><small>não cumulativa</small></div>
   </div>
  {{else}}
   <div class="pe-vitals"><div><label>Prestígio</label><strong>{{system.prestigio}} / 6</strong><span><button type="button" data-action="modify" data-field="system.prestigio" data-delta="-1">−</button><button type="button" data-action="modify" data-field="system.prestigio" data-delta="1">+</button></span></div><div><label>Moral</label><strong>{{system.moral}}</strong><span><button type="button" data-action="modify" data-field="system.moral" data-delta="-1">−</button><button type="button" data-action="modify" data-field="system.moral" data-delta="1">+</button></span></div></div>
  {{/unless}}
 </header>
 <nav class="pe-tabs" aria-label="Abas da ficha">
  {{#each (peTabs isSquad) as |entry|}}<button type="button" data-action="selectTab" data-tab="{{entry.id}}" class="{{#if (peEq ../tab entry.id)}}active{{/if}}">{{entry.label}}</button>{{/each}}
 </nav>
 <div class="pe-body">
 {{#if isSquad}}
  {{#if (peEq tab 'principal')}}
   <section class="pe-section"><h2>Comando estratégico <small>Operações: {{system.operacoes}}</small></h2><div class="pe-banner">O custo ordinário da saída é 1 Suprimento. A frente só avança por causa anunciada.</div><p><button type="button" data-action="squadDeploy">Registrar saída operacional (−1 Suprimento)</button></p><label>Notas de comando / vínculos <textarea name="system.notes" rows="9">{{system.notes}}</textarea></label></section>
  {{/if}}
  {{#if (peEq tab 'estrategia')}}
   <section class="pe-section"><h2>Estoques coletivos</h2><div class="pe-stocks">{{#each stocks as |stock|}}<div class="pe-stock"><b>{{stock.name}}</b><span><button type="button" data-action="squadAdjust" data-field="system.estoques.{{stock.name}}" data-delta="-1">−</button><strong>{{stock.value}}</strong><button type="button" data-action="squadAdjust" data-field="system.estoques.{{stock.name}}" data-delta="1">+</button></span></div>{{/each}}</div><h2>Estados da base</h2><div class="pe-stocks">{{#each states as |state|}}<div class="pe-stock"><b>{{state.name}}</b><span><button type="button" data-action="squadAdjust" data-field="system.estados.{{state.name}}" data-delta="-1">−</button><strong>{{state.value}}</strong><button type="button" data-action="squadAdjust" data-field="system.estados.{{state.name}}" data-delta="1">+</button><button type="button" data-action="squadRepair" data-track="{{state.name}}" title="Consumir 1 Peças antes do teste de reparo D2">Reparo</button></span></div>{{/each}}</div></section>
  {{/if}}
  {{#if (peEq tab 'frente')}}<section class="pe-section"><h2>Frentes da Guerra das Cinzas</h2><div class="pe-stocks">{{#each fronts as |front|}}<div class="pe-stock"><b>{{front.name}}</b><span><button type="button" data-action="squadAdjust" data-field="system.frentes.{{front.name}}" data-delta="-1">−</button><strong>{{front.value}} / 6</strong><button type="button" data-action="squadAdjust" data-field="system.frentes.{{front.name}}" data-delta="1">+</button></span></div>{{/each}}</div><p>Uma frente em 6 desencadeia crise local anunciada, não derrota global automática. Interdição por rádio requer gasto de 1 Comunicações antes da ofensiva e teste RAC + Estratégia D2.</p></section>{{/if}}
  {{#if (peEq tab 'recursos')}}<section class="pe-section"><h2>Doutrinas e ativos</h2>{{#each inventory.doutrina}}<article data-item-id="{{id}}" class="pe-entry"><b>{{name}}</b><button type="button" data-action="itemOpen">Abrir</button><button type="button" data-action="itemDelete">Excluir</button></article>{{/each}}{{#each inventory.ativo}}<article data-item-id="{{id}}" class="pe-entry"><b>{{name}}</b><button type="button" data-action="itemOpen">Abrir</button><button type="button" data-action="itemDelete">Excluir</button></article>{{/each}}<button type="button" data-action="createItem" data-type="ativo">Novo ativo</button><button type="button" data-action="createItem" data-type="doutrina">Nova doutrina</button></section>{{/if}}
 {{else}}
  {{#if (peEq tab 'principal')}}
   <section class="pe-section"><h2>Identidade e atributos</h2><div class="pe-fields"><label>Caminho<input name="system.caminho" value="{{system.caminho}}"></label><label>Trilha<input name="system.trilha" value="{{system.trilha}}"></label><label>Origem<input name="system.origin" value="{{system.origin}}"></label><label>Marcos<input name="system.marcos" type="number" min="0" value="{{system.marcos}}"></label></div>
    <div class="pe-attributes">{{#each attr as |a|}}<label>{{a.code}}<input name="system.atributos.{{a.code}}" type="number" min="0" max="10" value="{{a.value}}" /></label>{{/each}}</div>
    <div class="pe-resources"><label>PF<input name="system.pf" type="number" min="0" max="2" value="{{system.pf}}"></label><label>Éter pessoal<input name="system.eter" type="number" min="0" value="{{system.eter}}"></label><label>Munição (cargas especiais)<input name="system.municao" type="number" min="0" value="{{system.municao}}"></label><label>Ressonância<input name="system.ressonancia" type="number" min="0" value="{{system.ressonancia}}"></label><label>Traumas<input name="system.traumas" type="number" min="0" value="{{system.traumas}}"></label><label>RD natural<input name="system.baseRD" type="number" min="0" value="{{system.baseRD}}"></label></div>
    <div class="pe-tools"><button type="button" data-action="regroup">Reagrupar (MOR + Disciplina D1)</button><button type="button" data-action="rest" data-amount="10">Pausa segura (−10 BPM)</button><button type="button" data-action="rest" data-amount="20">Repouso protegido (−20 BPM)</button></div>
   </section>
  {{/if}}
  {{#if (peEq tab 'pericias')}}
   <section class="pe-section"><h2>Perícias <small>5–6 = 1 sucesso · 6 também gera Ímpeto após êxito</small></h2><div class="pe-roll-settings"><label>Dificuldade <select data-difficulty><option value="1">D1</option><option value="2">D2</option><option value="3">D3</option><option value="4">D4</option><option value="5">D5</option></select></label><label>Mod. dados <input data-modifier type="number" value="0" min="-10" max="2"></label><label>Teste sob pressão <input type="checkbox" data-under-pressure checked></label></div>
   <div class="pe-skill-groups">{{#each skills as |group|}}<div class="pe-skill-group"><h3>{{group.code}} — {{group.value}}</h3>{{#each group.skills as |skill|}}<div class="pe-skill-row"><button type="button" data-action="rollSkill" data-skill="{{skill.name}}">🎲 {{skill.name}}</button><input name="system.pericias.{{skill.name}}" type="number" min="0" max="4" value="{{skill.value}}"><select data-attribute><option value="{{group.code}}" selected>{{group.code}}</option>{{#each ../../attr as |attribute|}}{{#unless (peEq attribute.code group.code)}}<option value="{{attribute.code}}">{{attribute.code}}</option>{{/unless}}{{/each}}</select></div>{{/each}}</div>{{/each}}</div></section>
  {{/if}}
  {{#if (peEq tab 'combate')}}
   <section class="pe-section"><h2>Combate e condição</h2><div class="pe-roll-settings"><label>Dificuldade do ataque <select data-difficulty><option value="1">D1 exposto</option><option value="2">D2 cobertura parcial</option><option value="3">D3 extremo</option></select></label><label>Mod. dados <input data-modifier type="number" value="0" min="-10" max="2"></label></div><p>Um ataque comum causa dano fixo − RD, com até +2 de dano por Ímpetos declarados. Fogo de Fixação consome Munição, aplica PF2 em alvos legais e não causa dano.</p>
   {{#if isThreat}}<div class="pe-fields"><label>Reserva ataque<input name="system.attackPool" type="number" min="0" max="10" value="{{system.attackPool}}"></label><label>Dano fixo<input name="system.damage" type="number" min="0" value="{{system.damage}}"></label><label>Nível<input name="system.level" type="number" min="1" max="5" value="{{system.level}}"></label></div><button type="button" data-action="rollThreat">Rolar ataque da ameaça</button>{{/if}}
   {{#each inventory.arma as |it|}}<article class="pe-entry pe-weapon" data-item-id="{{it.id}}"><img src="{{it.img}}"/><div><b>{{it.name}}</b><small>Dano {{it.system.damage}} · {{it.system.range}} · {{it.system.tags}}</small>{{#if it.system.usesAmmo}}<small>Carregador {{it.system.ammo.magazine}} / {{it.system.ammo.capacity}} · reservas {{it.system.ammo.reserve}}</small>{{/if}}</div><div class="pe-entry-actions"><button type="button" data-action="attack">Atacar</button>{{#if (peIncludes it.system.tags 'SUP')}}<button type="button" data-action="suppress">Fixar (SUP)</button>{{/if}}<button type="button" data-action="reload">Recarregar</button><button type="button" data-action="itemOpen">Abrir</button></div></article>{{/each}}
  </section>{{/if}}
  {{#if (peEq tab 'inventario')}}
   <section class="pe-section"><h2>Inventário e armaduras</h2>{{#each inventory.arma as |it|}}<article class="pe-entry" data-item-id="{{it.id}}"><img src="{{it.img}}"><b>{{it.name}}</b><small>Dano {{it.system.damage}}</small><button type="button" data-action="itemOpen">Editar</button><button type="button" data-action="itemDelete">Excluir</button></article>{{/each}}
   {{#each inventory.armadura as |it|}}<article class="pe-entry" data-item-id="{{it.id}}"><img src="{{it.img}}"><b>{{it.name}}</b><small>RD {{it.system.rd}} • durabilidade {{it.system.durability}}%</small><button type="button" data-action="itemEquip">{{#if it.system.equipped}}Desequipar{{else}}Equipar{{/if}}</button><button type="button" data-action="itemOpen">Editar</button></article>{{/each}}
   {{#each inventory.equipamento as |it|}}<article class="pe-entry" data-item-id="{{it.id}}"><img src="{{it.img}}"><b>{{it.name}}</b><button type="button" data-action="itemEquip">{{#if it.system.equipped}}Desequipar{{else}}Equipar{{/if}}</button><button type="button" data-action="itemOpen">Editar</button><button type="button" data-action="itemDelete">Excluir</button></article>{{/each}}
   <div class="pe-tools"><button type="button" data-action="createItem" data-type="arma">+ Arma</button><button type="button" data-action="createItem" data-type="armadura">+ Armadura</button><button type="button" data-action="createItem" data-type="equipamento">+ Equipamento</button></div></section>
  {{/if}}
  {{#if (peEq tab 'dons')}}<section class="pe-section"><h2>Trilha, talentos e especializações</h2><p>Patamares P1 (0 Marcos), P3, P6, P9, P12. Frequência e custos devem obedecer à descrição do talento. Marcadores ativo/usado são estados manuais.</p>
   {{#each inventory.especializacao as |it|}}<article class="pe-entry" data-item-id="{{it.id}}"><b>{{it.name}}</b><small>{{it.system.path}}</small><button type="button" data-action="itemOpen">Abrir</button></article>{{/each}}
   {{#each inventory.talento as |it|}}<article class="pe-entry" data-item-id="{{it.id}}"><div><b>P{{it.system.tier}} · {{it.name}}</b><small>{{it.system.trail}} • {{it.system.usage}}</small></div><div class="pe-entry-actions"><button type="button" data-action="itemToggle">{{#if it.system.active}}Desativar{{else}}Ativar{{/if}}</button><button type="button" data-action="itemUse">Usar</button><button type="button" data-action="itemReset">Rearmar</button><button type="button" data-action="itemOpen">Editar</button></div></article>{{/each}}
   <button type="button" data-action="createItem" data-type="talento">Novo talento</button></section>{{/if}}
  {{#if (peEq tab 'rituais')}}<section class="pe-section"><h2>Éter e práticas</h2><p>Cargas pessoais disponíveis: {{system.eter}}. O ritual debita Éter mesmo em falha. Rituais não encerram automaticamente missões ou ignoram contramedidas.</p>{{#each inventory.ritual as |it|}}<article class="pe-entry" data-item-id="{{it.id}}"><img src="{{it.img}}"><div><b>{{it.name}}</b><small>D{{it.system.difficulty}} · {{it.system.cost}} Éter</small></div><button type="button" data-action="cast">Executar</button><button type="button" data-action="itemOpen">Editar</button></article>{{/each}}<button type="button" data-action="createItem" data-type="ritual">Novo ritual</button></section>{{/if}}
  {{#if (peEq tab 'notas')}}<section class="pe-section"><h2>Registro pessoal</h2><textarea name="system.notes" rows="20" placeholder="Vínculos, testemunhos, cicatrizes, ordens recusadas...">{{system.notes}}</textarea></section>{{/if}}
 {{/if}}
 </div>
 <footer class="pe-footer">PÓLVORA &amp; ÉTER • motor CLANDESTINO 5.2.2 adaptado • alfa 0.4 • registro do Serviço das Portas Fechadas</footer>
</div>
